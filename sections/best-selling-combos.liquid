{%- comment -%}
  #combos — horizontal, scroll-snapped rail of curated combos.
  Each combo is a block that points at a real, sellable "bundle" product for
  price/checkout, plus up to 3 display products for the tray photos+blurbs.
  See NOTES.md for why this needed a real product behind it rather than
  hand-typed prices.
{%- endcomment -%}

<section class="pl-scope pl-sec" id="{{ section.id }}" data-pl-section aria-labelledby="pl-combos-heading-{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="pl-d2" id="pl-combos-heading-{{ section.id }}" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="pl-rule" aria-hidden="true"><i></i>{% render 'pl-icon', icon: 'leaf' %}<i></i></div>
      {%- if section.settings.subheading != blank -%}
        <p class="pl-lede" style="margin:14px auto 0">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- assign combo_blocks = section.blocks | where: 'type', 'combo' -%}
    {%- if combo_blocks.size > 0 -%}
      <div class="pl-comborail pl-rv" role="list" aria-label="Best-selling combos, scroll for more">
        {%- for block in combo_blocks -%}
          <div role="listitem">{%- render 'pl-combo-card', block: block -%}</div>
        {%- endfor -%}
      </div>
      <div class="pl-swipecue" aria-hidden="true">{% render 'pl-icon', icon: 'swipe' %}Swipe for more combos</div>
      {%- if section.settings.footnote != blank -%}
        <p class="pl-railnote">{{ section.settings.footnote }}</p>
      {%- endif -%}
    {%- else -%}
      <p class="pl-body-s" style="text-align:center">Add combo blocks in the section settings to populate this rail.</p>
    {%- endif -%}
  </div>
</section>

{%- schema -%}
{
  "name": "Best-selling combos",
  "tag": "section",
  "class": "pl-section-combos",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own." },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay." }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        { "type": "product", "id": "bundle_product", "label": "Bundle product", "info": "The real, purchasable product. Price, compare-at price and checkout all come from here." },
        { "type": "text", "id": "title", "label": "Display title", "info": "Leave blank to use the bundle product's title" },
        { "type": "text", "id": "item_count", "label": "Item count label", "default": "3" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "select", "id": "flag", "label": "Flag", "options": [
          { "value": "none", "label": "None" },
          { "value": "most_popular", "label": "Most popular" },
          { "value": "best_value", "label": "Best value" }
        ], "default": "none" },
        { "type": "text", "id": "save_label", "label": "Save badge override", "info": "Leave blank to auto-calculate from the bundle product's compare-at price" },
        { "type": "header", "content": "Tray item 1" },
        { "type": "product", "id": "item_product_1", "label": "Product" },
        { "type": "text", "id": "item_blurb_1", "label": "Blurb" },
        { "type": "header", "content": "Tray item 2" },
        { "type": "product", "id": "item_product_2", "label": "Product" },
        { "type": "text", "id": "item_blurb_2", "label": "Blurb" },
        { "type": "header", "content": "Tray item 3 (optional)" },
        { "type": "product", "id": "item_product_3", "label": "Product" },
        { "type": "text", "id": "item_blurb_3", "label": "Blurb" }
      ]
    }
  ],
  "presets": [
    { "name": "Best-selling combos", "blocks": [ { "type": "combo" }, { "type": "combo" }, { "type": "combo" } ] }
  ]
}
{%- endschema -%}

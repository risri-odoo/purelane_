{%- comment -%}
  #shop — "Bestsellers" product grid.
  Source file hardcoded 8 <article> cards, half using CSS background-image
  sprites and half using inline duplicate-of-the-same-product SVGs, with
  every price/rating/title hand typed. Here the merchant picks a collection
  (or individual products) and every card renders from real product data.
{%- endcomment -%}

<section class="pl-scope pl-sec" id="{{ section.id }}" data-pl-section aria-labelledby="pl-shop-heading-{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-panel-head pl-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      <h2 class="pl-d2" id="pl-shop-heading-{{ section.id }}" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="pl-rule" aria-hidden="true"><i></i>{% render 'pl-icon', icon: 'leaf' %}<i></i></div>
    </div>

    <div class="pl-shelf">
      {%- if section.settings.collection != blank -%}
        {%- for product in section.settings.collection.products limit: section.settings.product_limit -%}
          {%- assign stagger = forloop.index0 | modulo: 4 -%}
          {%- assign stagger_class = 'pl-rv-d' | append: stagger -%}
          {%- render 'pl-product-card', product: product, card_class: stagger_class -%}
        {%- endfor -%}
      {%- endif -%}

      {%- comment -%} Manually-picked products (blocks) always render after the
      collection pull, letting a merchant pin specific SKUs — e.g. the
      "long title" and "no image" seed products — without needing a
      dedicated collection just for the homepage. {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' and block.settings.product != blank -%}
          {%- assign stagger = forloop.index0 | modulo: 4 -%}
          {%- assign stagger_class = 'pl-rv-d' | append: stagger -%}
          {%- render 'pl-product-card', product: block.settings.product, badge_text: block.settings.badge_override, card_class: stagger_class -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.collection == blank and section.blocks.size == 0 -%}
      <p class="pl-body-s" style="text-align:center">
        {{ 'Select a collection or add product blocks in the section settings to populate this grid.' }}
      </p>
    {%- endif -%}
  </div>
</section>

{%- schema -%}
{
  "name": "Shop product grid",
  "tag": "section",
  "class": "pl-section-shop",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Cards render in this collection's sort order. Combine with product blocks below to pin extra items."
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products from collection",
      "min": 2, "max": 24, "step": 1, "default": 8
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Pinned product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "badge_override", "label": "Badge text override", "info": "Leave blank to use the product's Badge label metafield (custom.badge_label)." }
      ]
    }
  ],
  "presets": [
    { "name": "Shop product grid", "blocks": [] }
  ]
}
{%- endschema -%}

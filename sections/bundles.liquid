{%- comment -%}
  #bundles — "One box. Every room." tier picker (2/3/5-product boxes).
  Note: the actual pick-your-own-products interaction from the prototype
  (choosing which 2, 3 or 5 products go in the box) is a cart/checkout
  feature, not a homepage layout concern — it belongs to whatever powers
  the box builder (native Shopify Bundles, or a build-a-box app). This
  section is the marketing entry point into that flow; each tier's CTA
  links straight to the corresponding build-a-box product/page.
{%- endcomment -%}

<section class="pl-scope pl-sec" id="{{ section.id }}" data-pl-section aria-labelledby="pl-bundles-heading-{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-glass pl-sec-pad pl-rv" style="margin-bottom:16px">
      <div class="pl-panel-head" style="margin-bottom:0">
        {%- if section.settings.kicker != blank -%}
          <span class="pl-kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        <h2 class="pl-d2" id="pl-bundles-heading-{{ section.id }}" style="margin-top:12px">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="pl-lede" style="margin:0 auto">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- assign tier_blocks = section.blocks | where: 'type', 'tier' -%}
    {%- if tier_blocks.size > 0 -%}
      <div class="pl-tiers">
        {%- for block in tier_blocks -%}
          {%- render 'pl-tier-card', block: block -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="pl-body-s" style="text-align:center">Add tier blocks in the section settings.</p>
    {%- endif -%}
  </div>
</section>

{%- schema -%}
{
  "name": "Bundles",
  "tag": "section",
  "class": "pl-section-bundles",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way." }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        { "type": "product", "id": "tier_product", "label": "Tier product", "info": "Real product this tier sells (e.g. \"Build Your Box – 3 Products\"). Price/compare-at come from here." },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Starter" },
        { "type": "range", "id": "product_count", "label": "Products in this tier", "min": 2, "max": 8, "step": 1, "default": 2 },
        { "type": "checkbox", "id": "featured", "label": "Highlight as most popular", "default": false },
        { "type": "textarea", "id": "bullets", "label": "Feature bullets", "info": "One per line", "default": "Pick any two products\nFree shipping across India" },
        { "type": "text", "id": "cta_label", "label": "Button label override" },
        { "type": "url", "id": "cta_url", "label": "Button link override" },
        { "type": "header", "content": "Tray photos (up to 5, matches product count)" },
        { "type": "product", "id": "tray_product_1", "label": "Photo 1" },
        { "type": "product", "id": "tray_product_2", "label": "Photo 2" },
        { "type": "product", "id": "tray_product_3", "label": "Photo 3" },
        { "type": "product", "id": "tray_product_4", "label": "Photo 4" },
        { "type": "product", "id": "tray_product_5", "label": "Photo 5" }
      ]
    }
  ],
  "presets": [
    { "name": "Bundles", "blocks": [ { "type": "tier" }, { "type": "tier", "settings": { "featured": true } }, { "type": "tier" } ] }
  ]
}
{%- endschema -%}
